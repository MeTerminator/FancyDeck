# ── 依赖与构建产物 ──────────────────────────────────────────────────────
node_modules/
dist/
*.tsbuildinfo

# 包管理器用的是 pnpm（见 pnpm-workspace.yaml），
# npm 那份 lock 留着只会让两边各装一套，不要它
package-lock.json

# ── 运行时数据 ──────────────────────────────────────────────────────────
# 服务端把配置写在这儿：主题、插件开关、城市、所有布局预设。
# 它是「这台机器上的状态」，不是源码——首次启动会按 src/core/defaults.ts 重新生成。
# 里面还带着所在城市这类个人信息，更不该进仓库。
data/

# ── 不进仓库的本地目录 ──────────────────────────────────────────────────
# scripts/  冒烟检查（pnpm check / check:ui / check:lunar）
# agent/    采集端与上报测试客户端
# design/   设计稿
scripts/
agent/
design/

# ── Python 副产物 ───────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ── 环境与密钥 ──────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── 编辑器与系统 ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# ── 日志与临时文件 ──────────────────────────────────────────────────────
*.log
npm-debug.log*
pnpm-debug.log*
.cache/
tmp/
